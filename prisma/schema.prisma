generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl bypasses the connection pooler for Prisma migrations (required by Supabase pgbouncer)
  directUrl = env("DIRECT_URL")
}

enum VehicleCategory {
  TURISMOS
  FURGONETAS
  SUV_4X4
  AUTOCARAVANAS
}

enum FuelType {
  GASOLINA
  DIESEL
  ELECTRICO
  HIBRIDO
}

enum TransmissionType {
  MANUAL
  AUTOMATICO
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EmailKind {
  BOOKING_ADMIN
  BOOKING_CUSTOMER
  CONTACT_ADMIN
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

model Office {
  id                 String        @id @default(cuid())
  slug               String        @unique
  city               String
  address            String
  phone              String
  email              String
  hours              String
  lat                Float
  lng                Float
  description        String
  vehicles           Vehicle[]
  reservations       Reservation[] @relation("PickupOffice")
  returnReservations Reservation[] @relation("ReturnOffice")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("offices")
}

model Vehicle {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  brand        String
  category     VehicleCategory
  seats        Int
  power        String
  fuel         FuelType
  transmission TransmissionType
  dailyRate    Decimal          @db.Decimal(10, 2)
  imageUrl     String
  highlight    String
  isActive     Boolean          @default(true)
  officeId     String
  office       Office           @relation(fields: [officeId], references: [id])
  reservations Reservation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([officeId])
  @@index([category])
  @@index([isActive])
  @@map("vehicles")
}

model Client {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String        @unique
  phone        String
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("clients")
}

/// Una fila de `reservations` es una SOLICITUD de reserva recibida por la web.
/// No se confirma automáticamente: nace en PENDING y el equipo la valida.
/// Por eso `vehicleId` es opcional: si en el momento de la solicitud no hay
/// unidad libre de esa gama, la solicitud se guarda igual (nunca se pierde un
/// cliente) y queda marcada con `needsAvailabilityCheck`.
model Reservation {
  id               String             @id @default(cuid())
  confirmationCode String             @unique
  vehicleId        String?
  vehicle          Vehicle?           @relation(fields: [vehicleId], references: [id])
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id])
  officeId         String
  office           Office             @relation("PickupOffice", fields: [officeId], references: [id])
  returnOfficeId   String
  returnOffice     Office             @relation("ReturnOffice", fields: [returnOfficeId], references: [id])
  /// Fecha y hora exactas acordadas con el cliente (Europe/Madrid)
  pickupAt         DateTime
  returnAt         DateTime
  startDate        DateTime           @db.Date
  endDate          DateTime           @db.Date
  totalDays        Int
  /// Gama seleccionada en el catálogo (`server/src/config/catalog.ts`)
  tariffId         String
  tariffName       String
  plannedKm        Int
  includedKm       Int
  extraKm          Int
  extraKmRate      Decimal            @db.Decimal(10, 4)
  extraKmSurcharge Decimal            @db.Decimal(10, 2) @default(0)
  /// Precio base del alquiler por los días contratados (null si es «bajo consulta»)
  baseTotal        Decimal?           @db.Decimal(10, 2)
  dailyRate        Decimal            @db.Decimal(10, 2)
  extrasTotal      Decimal            @db.Decimal(10, 2) @default(0)
  /// Total estimado. null cuando la gama se cotiza a mano.
  totalAmount      Decimal?           @db.Decimal(10, 2)
  deposit          Decimal            @db.Decimal(10, 2) @default(0)
  franchise        Decimal            @db.Decimal(10, 2) @default(0)
  status           ReservationStatus  @default(PENDING)
  needsAvailabilityCheck Boolean      @default(false)
  notes            String?
  /// Momento en que el cliente aceptó la política de privacidad (RGPD)
  consentAt        DateTime?
  extras           ReservationExtra[]
  emails           EmailLog[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([vehicleId, startDate, endDate])
  @@index([status])
  @@index([createdAt])
  @@map("reservations")
}

model ReservationExtra {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  /// id del extra en el catálogo (p. ej. `babySeat`, `additionalDriver`)
  type          String
  /// etiqueta congelada en el momento de la solicitud, para que el histórico
  /// no cambie si mañana se reescribe el catálogo
  label         String
  /// 'per_rental' | 'per_day'
  unit          String
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2)
  totalPrice    Decimal     @db.Decimal(10, 2)

  @@index([reservationId])
  @@map("reservation_extras")
}

/// Traza de cada email que el sistema intenta enviar. Sin esto, un fallo del
/// proveedor es invisible y la solicitud del cliente se pierde en silencio.
model EmailLog {
  id            String       @id @default(cuid())
  kind          EmailKind
  status        EmailStatus
  to            String
  subject       String
  /// messageId devuelto por el proveedor cuando el envío es correcto
  providerId    String?
  error         String?
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
  @@index([reservationId])
  @@map("email_logs")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}
