# Copia este archivo a server/.env y rellena los valores.
# server/.env está en .gitignore: NUNCA subas credenciales reales al repositorio.

# === Base de datos (Supabase) ===
# Conexión con pooler (runtime) — puerto 6543, pgbouncer en modo Transaction
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (migraciones de Prisma) — puerto 5432, sin pooler
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# === Servidor ===
PORT=3001
NODE_ENV=development

# === CORS ===
# Lista de orígenes permitidos separados por comas.
# Producción (incluye SIEMPRE el dominio apex y el www; el matching es exacto):
# CORS_ORIGIN=https://alcocars.es,https://www.alcocars.es,https://alcocars.vercel.app
CORS_ORIGIN=http://localhost:5173

# === Auth ===
# Mínimo 32 caracteres en producción (se comprueba al arrancar)
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-de-32-caracteres-minimo

# === Email (API de Brevo por HTTPS/443) ===
# 1. Crea una cuenta gratuita en https://www.brevo.com (300 emails/día)
# 2. Verifica un remitente en Senders & IPs → Senders
# 3. Crea una API Key en https://app.brevo.com/settings/keys/api
# Si BREVO_API_KEY queda vacío, el sistema NO rompe: guarda la reserva,
# registra el email como SKIPPED en la tabla email_logs y escribe una vista
# previa HTML en server/.mail-preview/ para revisar el diseño en local.
BREVO_API_KEY=
# Remitente verificado en Brevo. Formato: Nombre <email@dominio.es>
SMTP_FROM=Alcocars <reservas@alcocars.es>
# Buzón interno que recibe los avisos de reservas y de contacto
NOTIFY_EMAIL=ruviar@gmail.com
